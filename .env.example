# Modelo OpenDots: a interface mostra a configuração inicial até estes campos serem definidos.
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=data/opendots.sqlite
# Mantenha OWNER_ID estável: ele identifica o proprietário das conversas persistentes no Intelligence.
OWNER_ID=opendots-owner
# npm run dev permite as origens http://localhost:5173 e http://127.0.0.1:5173.
# APP_ORIGIN substitui esses padrões por origens exatas separadas por vírgula.
# Inclua esquema, host e porta; omita caminhos e barras finais.
# APP_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Obrigatório para vincular HOST externamente (24+ caracteres); também habilita login local.
# OWNER_TOKEN=

# `copilotkit project select` ou `local connect` grava CPK_INTELLIGENCE_API_KEY.
# O servidor aceita qualquer um dos nomes e prioriza CPK_INTELLIGENCE_API_KEY quando não estiver vazio.
INTELLIGENCE_API_KEY=
# INTELLIGENCE_API_URL=
# `local connect` grava este endpoint; ele tem prioridade sobre o nome legado.
# INTELLIGENCE_GATEWAY_WS_URL=
# INTELLIGENCE_WS_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Mantenha o CPK_TELEMETRY_ID gerado pela CLI junto com a chave do projeto correspondente.
# O SDK o usa para associar o uso do OpenDots à conta Intelligence.
# CPK_TELEMETRY_ID=
# A telemetria de uso do SDK vem ativada por padrão (separada das conversas).
# Consulte docs/TELEMETRY.md sobre relatórios e validação de cadastros.
# Substituição opcional da taxa de amostragem (padrão 1):
# COPILOTKIT_TELEMETRY_SAMPLE_RATE=1
# Qualquer uma das opções abaixo desativa a telemetria:
# COPILOTKIT_TELEMETRY_DISABLED=true
# DO_NOT_TRACK=1

# Navegador opcional e isolado, somente leitura, para WEB_SEARCH_PROVIDER=browser.
BROWSER_URL=http://127.0.0.1:4311
BROWSER_SECRET=
BROWSER_HOST=127.0.0.1
BROWSER_PORT=4311
# Use o mesmo segredo aleatório com 24+ caracteres no app e no navegador. Redirecionamentos são bloqueados.
# Informe URLs públicas canônicas. Use o contêiner de navegador separado para isolamento.

# Voz em tempo real opcional; a execução usa a mesma Thread Intelligence configurada.
VOICE_API_KEY=
VOICE_MODEL=
VOICE_NAME=marin

# Canal Slack gerenciado opcional; consulte docs/SETUP.md#slack.
# Use o nome da declaração gerenciada, não o nome de uma conversa do Slack.
# O OpenTag chama essa variável INTELLIGENCE_CHANNEL_NAME; o OpenDots usa SLACK_CHANNEL_NAME.
# Autorize o workspace do Slack e IDs específicos de usuários.
SLACK_CHANNEL_NAME=
SLACK_TEAM_ID=
SLACK_USER_IDS=
# SLACK_DOT_ID= (defaults to the initial Dot)

# Computadores persistentes opcionais, um por Dot, usando serviços OpenBot.
# Consulte docs/COMPUTERS.md. Mantenha estes dois segredos aleatórios diferentes no servidor.
COMPUTER_SUPERVISOR_URL=
COMPUTER_SUPERVISOR_TOKEN=
COMPUTER_TOKEN=
# Mantenha estável: o namespace identifica contêineres existentes e volumes persistentes.
COMPUTER_NAMESPACE=opendots
# COMPUTER_MEMORY_BYTES=2147483648
# COMPUTER_RUNTIME=runsc
# ENGINE_SOCKET=/var/run/docker.sock

# Provedor de pesquisa na Web pública: parallel (padrão), browser (somente URLs) ou disabled.
# Consultas e URLs selecionadas são enviadas ao Parallel; o modo de exemplo não chama provedores.
WEB_SEARCH_PROVIDER=parallel
# Chave Bearer opcional para produção/limites maiores; o MCP anônimo permite uso leve.
PARALLEL_API_KEY=
